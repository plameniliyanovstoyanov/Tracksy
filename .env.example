# ================================
# Environment Configuration Example
# ================================
# 
# Копирай този файл като `.env` и попълни стойностите.
# ВАЖНО: Никога не commit-вай `.env` файла в Git!
#

# ── Supabase Configuration ──────────────────────────────────────────
# Получи от: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Mapbox Configuration ────────────────────────────────────────────
# Получи от: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# ── RevenueCat Configuration (Premium subscriptions) ────────────────
# Получи от: https://app.revenuecat.com/apps
# iOS API Key (за iOS builds)
EXPO_PUBLIC_RC_IOS_API_KEY=appl_your-ios-key-here

# Android API Key (за Android builds)
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_your-android-key-here

# ── AdMob Configuration (Optional - вече е в app.config.js) ─────────
# App ID и Ad Unit ID-та са директно в app.config.js и lib/ads.ts
# Не е нужно да ги слагаш тук, освен ако не искаш dynamic конфигурация.

# ── Notes ───────────────────────────────────────────────────────────
# - Supabase: Задължителен за auth, database, profiles
# - Mapbox: Задължителен за карти и route visualization
# - RevenueCat: Задължителен за Premium subscriptions (премахване на реклами)
# - AdMob: Конфигурацията е в app.config.js - виж docs/ADMOB_SETUP.md
